{
  "name": "extend-sdk-mcp-server",
  "version": "2026.4.1",
  "description": "Searchable AccelByte Extend SDK reference (C#, Go, Java, Python) for AI coding assistants",
  "keywords": [
    "mcp",
    "server",
    "accelbyte",
    "extend",
    "sdk"
  ],
  "author": "AccelByte Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AccelByte/ags-extend-sdk-mcp-server.git"
  },
  "homepage": "https://github.com/AccelByte/ags-extend-sdk-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/AccelByte/ags-extend-sdk-mcp-server/issues"
  },
  "type": "module",
  "scripts": {
    "sync:server-version": "node sync-server-version.js",
    "build": "pnpm run sync:server-version && tsc -p tsconfig.build.json && cp -r assets dist/ 2>/dev/null || true",
    "build+": "pnpm run format && pnpm run lint && pnpm run build",
    "start": "pnpm run start:stdio",
    "start:stdio": "MCP_TRANSPORT=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "pnpm run inspect:stdio",
    "inspect:stdio": "MCP_TRANSPORT=stdio pnpm dlx @modelcontextprotocol/inspector --transport stdio -e MCP_TRANSPORT=stdio node dist/index.js",
    "inspect:http": "MCP_TRANSPORT=http node dist/index.js & sleep 2 && pnpm dlx @modelcontextprotocol/inspector --transport http --server-url http://localhost:3000/mcp",
    "inspect:clean": "pkill -f '@modelcontextprotocol/inspector' || true && pkill -f 'node dist/index.js' || true",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "type-check": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
